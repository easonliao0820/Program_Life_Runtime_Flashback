[sub_resource type="Resource" id="Resource_line1"]
script = ExtResource("1_step")
speaker = "系統"
line = "早餐：豆漿 25 元、草莓吐司 60 元，今天有早餐優惠打 85 折。店員跟你說總共要 72 元，聽起來對嗎？"

[sub_resource type="Resource" id="Resource_line2"]
script = ExtResource("1_step")
speaker = ""
line = "（範例：soy_milk = 25　strawberry_toast = 60　clerk_total = 72　my_answer = round((soy_milk + strawberry_toast) * 0.85)　if my_answer == clerk_total: print(\"Success! It's 72 dollars.\")　else: print(\"Something is wrong.\")）"

[sub_resource type="Resource" id="Resource_line3"]
script = ExtResource("1_step")
speaker = "派森"
line = "「照著這個方法，算算看店員報的價錢對不對吧。」"

[resource]
script = ExtResource("2_data")
