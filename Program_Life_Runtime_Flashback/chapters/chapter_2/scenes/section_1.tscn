text = "💻 程式概念：變數、運算、判斷"

[node name="ProgText" type="RichTextLabel" parent="TextbookLayer/TextbookPanel/WindowContainer/MarginContainer/VBox/Body/RightCol"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.901961, 0.901961, 0.901961, 1)
theme_override_font_sizes/normal_font_size = 15
bbcode_enabled = true
text = "[b]1. 變數 (Variable)[/b]
用 [code]=[/code] 把值放進一個有名字的盒子裡：[code]love = \"you\"[/code]

[b]2. 運算 (+)[/b]
變數可以直接相加：[code]print(item1 + item2)[/code]

[b]3. 布林與 if / else[/b]
[code]round()[/code] 四捨五入，[code]if 條件: ... else: ...[/code] 依條件走不同分支。"
